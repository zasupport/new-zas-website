node_modules/
/.next/
/out/
.env
.env.local
.env.*.local
.vercel
*.tsbuildinfo
next-env.d.ts
.DS_Store
npm-debug.log*

# Security: credential documents — never commit files with literal secrets
docs/seo/*PLATFORM*SETUP*.md
docs/seo/*CREDENTIALS*.md
docs/seo/*API*KEYS*.md
*SETUP*GUIDE*.md
*.env.secret
docs/seo/.advisor-gap-inbox.jsonl
docs/seo/advisor-gap-inbox.md

# Python bytecode — tracked .pyc caused an audit tool to score itself WIRED by its own
# bytecode (grep -r descends __pycache__). Never track compiled artefacts.
__pycache__/
*.pyc

# Claude Code project framework — machine-local state (never commit).
# The Stop guards scan uncommitted work, so local state must be ignored,
# not left stranded in the working tree where it re-blocks every turn.
.claude/.append-guard-*
.claude/*.ndjson
.claude/validation.log
.claude/claims-ledger.json
.claude/environment.json
.claude/install-inventory.json
.claude/learning-ledger.md
.claude/settings.local.json
.claude/patterns/
.claude/persistence/
.claude/reports/
.claude/capture/
.claude/_archive/
.claude/worktrees/

# robots index guard runtime
tools/robots/state/
tools/robots/_archive/
tools/robots/inbox/
tools/robots/.venv/
tools/robots/.staging/
tools/robots/validation.log

# transient backups / office locks (§573 — never commit)
*.bak
*.pre-*-bak
~$*
.mcp.json.pre-*

# Playwright ephemeral output — never a tracked deliverable (repo-hygiene, 26/09/2026)
test-results/

# Timestamped baseline-engine run snapshots (regenerable, not canonical, 26/09/2026)
docs/governance/baselines/

# Internal CC/Perplexity session handoffs, audits, triage + working plans (contain machine
# paths + internal governance — keep OUT of the public repo). The intentionally-tracked
# curated docs (ZA Support Website Build Master Handoff.md, MASTER-LOSSLESS-HANDOFF-website-session-*,
# claude-ai-project-instructions.md, *-selfheal-handoff.md) have distinct names and stay tracked.
docs/governance/BLOG-MONOLITH-*
docs/governance/CLOUD-LOCAL-ROUTING-*
docs/governance/MASTER-LOSSLESS-CLAUDE-CODE-*
docs/governance/SESSION-TODO-*
docs/governance/STANDING-RULE-*
docs/governance/UNCOMMITTED-PATHS-*
docs/governance/inbox/
docs/governance/*.pre-*

# Timestamped operating-system run-output snapshots (regenerable internal build/release
# cycle output — same class as docs/governance/baselines). Named release docs under
# docs/operating-system/ are NOT ignored here (they may be intentional, tracked release docs).
docs/operating-system/*T[0-9][0-9][0-9][0-9][0-9][0-9]Z/
docs/operating-system/*-20[0-9][0-9][0-9][0-9][0-9][0-9]T*Z.md
docs/operating-system/commercial-discovery/
docs/operating-system/daily-seo-intelligence/

# Dated blog-supply curated-topic snapshots (regenerable daily output)
docs/seo/curated-informational-topics-*.json

# Timestamped post-deploy SEO-measurement snapshots (§795 site-improve) — regenerable output
docs/governance/seo-measurement/
